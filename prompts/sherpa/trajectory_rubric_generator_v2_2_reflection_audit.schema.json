{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:trajectory-rubric-generator:v2.2:all-reflection-claims",
  "title": "Trajectory analysis candidate v2 with intervention instruction",
  "type": "object",
  "properties": {
    "rubric_id": {
      "type": "string",
      "minLength": 1
    },
    "source_case_id": {
      "type": [
        "string",
        "integer"
      ]
    },
    "source_trajectory_id": {
      "type": [
        "string",
        "integer"
      ]
    },
    "source_outcome": {
      "type": "string",
      "enum": [
        "success",
        "failure"
      ]
    },
    "analysis": {
      "type": "object",
      "properties": {
        "surface_request": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "decision_shaping_contribution": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "user_contribution": {
          "type": "string",
          "minLength": 1
        },
        "agent_side_state": {
          "type": "string",
          "minLength": 1
        },
        "surface_handling": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "reasoning_handling": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "agent_handling": {
          "type": "string",
          "minLength": 1
        },
        "interaction_need": {
          "type": "string",
          "minLength": 1
        },
        "selected_behavior": {
          "type": "string",
          "minLength": 1
        },
        "selection_rationale": {
          "type": "string",
          "minLength": 1
        },
        "source_behavior_support": {
          "type": "string",
          "minLength": 1
        },
        "behavior_to_preserve_or_correct": {
          "type": "string",
          "minLength": 1
        },
        "score_construction_check": {
          "type": "object",
          "properties": {
            "score_0_basis": {
              "type": "string",
              "minLength": 1
            },
            "score_1_component": {
              "type": "string",
              "minLength": 1
            },
            "score_1_remaining_gap": {
              "type": "string",
              "minLength": 1
            },
            "score_2_basis": {
              "type": "string",
              "minLength": 1
            },
            "conclusion_independence": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "score_0_basis",
            "score_1_component",
            "score_1_remaining_gap",
            "score_2_basis",
            "conclusion_independence"
          ],
          "additionalProperties": false
        },
        "source_score": {
          "type": "integer",
          "enum": [
            0,
            2
          ]
        },
        "score_0_basis": {
          "type": "string",
          "enum": [
            "counterfactual_removal",
            "observed_problem"
          ]
        },
        "selected_agent_turn_id": {
          "type": [
            "string",
            "integer"
          ]
        },
        "feedback_check": {
          "type": "object",
          "properties": {
            "claim": {
              "type": [
                "string",
                "null"
              ],
              "minLength": 1
            },
            "assessment": {
              "type": "string",
              "enum": [
                "supported",
                "partly_supported",
                "unsupported",
                "contradicted",
                "not_provided"
              ]
            },
            "dialogue_basis": {
              "type": [
                "string",
                "null"
              ],
              "minLength": 1
            },
            "claim_reviews": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "feedback_kind",
                  "feedback_index",
                  "reported_agent_turn_id",
                  "claim",
                  "decision",
                  "accepted_part",
                  "rejected_part",
                  "reason",
                  "actual_agent_turn_id",
                  "agent_evidence",
                  "prior_context",
                  "retrospective_only"
                ],
                "properties": {
                  "feedback_kind": {
                    "type": "string",
                    "enum": [
                      "helpful",
                      "unresolved"
                    ]
                  },
                  "feedback_index": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "reported_agent_turn_id": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "claim": {
                    "type": "string",
                    "minLength": 1
                  },
                  "decision": {
                    "type": "string",
                    "enum": [
                      "accept",
                      "partly_accept",
                      "reject"
                    ]
                  },
                  "accepted_part": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "minLength": 1
                  },
                  "rejected_part": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "minLength": 1
                  },
                  "reason": {
                    "type": "string",
                    "minLength": 1
                  },
                  "actual_agent_turn_id": {
                    "type": [
                      "integer",
                      "null"
                    ],
                    "minimum": 1
                  },
                  "agent_evidence": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "speaker",
                        "turn_id",
                        "quote"
                      ],
                      "properties": {
                        "speaker": {
                          "type": "string",
                          "enum": [
                            "agent"
                          ]
                        },
                        "turn_id": {
                          "type": "integer",
                          "minimum": 1
                        },
                        "quote": {
                          "type": "string",
                          "minLength": 1
                        }
                      }
                    }
                  },
                  "prior_context": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "speaker",
                        "turn_id",
                        "quote"
                      ],
                      "properties": {
                        "speaker": {
                          "type": "string",
                          "enum": [
                            "doctor",
                            "agent"
                          ]
                        },
                        "turn_id": {
                          "type": "integer",
                          "minimum": 1
                        },
                        "quote": {
                          "type": "string",
                          "minLength": 1
                        }
                      }
                    }
                  },
                  "retrospective_only": {
                    "type": "boolean"
                  }
                }
              }
            }
          },
          "required": [
            "claim",
            "assessment",
            "dialogue_basis",
            "claim_reviews"
          ],
          "additionalProperties": false
        },
        "evidence_strength": {
          "type": "string",
          "enum": [
            "strong",
            "limited"
          ]
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "evidence_spans": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "properties": {
              "turn_id": {
                "type": [
                  "string",
                  "integer"
                ]
              },
              "speaker": {
                "type": "string",
                "enum": [
                  "doctor",
                  "agent"
                ]
              },
              "quote": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "turn_id",
              "speaker",
              "quote"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "surface_request",
        "decision_shaping_contribution",
        "user_contribution",
        "agent_side_state",
        "surface_handling",
        "reasoning_handling",
        "agent_handling",
        "interaction_need",
        "selected_behavior",
        "selection_rationale",
        "source_behavior_support",
        "behavior_to_preserve_or_correct",
        "score_construction_check",
        "source_score",
        "score_0_basis",
        "selected_agent_turn_id",
        "feedback_check",
        "evidence_strength",
        "limitations",
        "evidence_spans"
      ],
      "additionalProperties": false
    },
    "candidate_rubric": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "applicability": {
          "type": "object",
          "properties": {
            "user_side_context": {
              "type": "string",
              "minLength": 1
            },
            "agent_side_state": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "user_side_context",
            "agent_side_state"
          ],
          "additionalProperties": false
        },
        "scores": {
          "type": "object",
          "properties": {
            "0": {
              "type": "object",
              "properties": {
                "user_side_context": {
                  "type": "string",
                  "minLength": 1
                },
                "agent_side_state": {
                  "type": "string",
                  "minLength": 1
                },
                "behavior": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "user_side_context",
                "agent_side_state",
                "behavior"
              ],
              "additionalProperties": false
            },
            "1": {
              "type": "object",
              "properties": {
                "user_side_context": {
                  "type": "string",
                  "minLength": 1
                },
                "agent_side_state": {
                  "type": "string",
                  "minLength": 1
                },
                "behavior": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "user_side_context",
                "agent_side_state",
                "behavior"
              ],
              "additionalProperties": false
            },
            "2": {
              "type": "object",
              "properties": {
                "user_side_context": {
                  "type": "string",
                  "minLength": 1
                },
                "agent_side_state": {
                  "type": "string",
                  "minLength": 1
                },
                "behavior": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "user_side_context",
                "agent_side_state",
                "behavior"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "0",
            "1",
            "2"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "name",
        "applicability",
        "scores"
      ],
      "additionalProperties": false
    },
    "intervention_instruction": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    }
  },
  "required": [
    "rubric_id",
    "source_case_id",
    "source_trajectory_id",
    "source_outcome",
    "analysis",
    "candidate_rubric",
    "intervention_instruction"
  ],
  "additionalProperties": false
}
