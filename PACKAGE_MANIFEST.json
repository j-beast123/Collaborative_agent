{
  "schema": "sherpa_package_v2",
  "default_config": "configs/group_a100_partner_state.json",
  "doctor": {
    "provider": "openai_direct",
    "model": "gpt-6-luna",
    "max_concurrent_requests": 50
  },
  "assistant": {
    "model": "Qwen/Qwen3-8B",
    "temperature": 1.0
  },
  "rollout": {
    "budget": "initial_fanout",
    "trajectories": 32,
    "fork_after": "doctor_opening",
    "later_forks": false
  },
  "validation": "not_run"
}
